# Preserve S00 document/evidence bytes for SHA256 and append-only history.
# Source-code attributes may be defined when S01 is explicitly authorized.
README.md -text
docs/** -text

# S01 source conventions; SQL checksums must survive checkout byte-for-byte.
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.toml text eol=lf
uv.lock text eol=lf
*.sql -text
*.ps1 -text
backend/.env.example -text

# Preserve attributes themselves; stabilize other text metadata on Windows.
.gitattributes -text
.gitignore text eol=lf
backend/.python-version text eol=lf

# S02 fixture manifests have stable checkout bytes.
backend/data/demo/*.json text eol=lf

# The POSIX launcher needs an LF shebang in every checkout.
backend/start.sh text eol=lf
