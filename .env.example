# Copy to .env locally if custom settings are needed. Never commit .env.
APP_ENV=local
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=var/app-demo.sqlite3
AUTH_MODE=demo
LLM_MODE=mock
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
DIALOGUE_PIPELINE=single_pass
SINGLE_PASS_MAX_ATTEMPTS=2
STAR_MAX_ATTEMPTS=8
STAR_MAX_CANDIDATES=2
LLM_MAX_OUTPUT_TOKENS=1024
CONFIG_VERSION=s01-config-v1
