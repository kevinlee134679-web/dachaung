# Copy to .env locally if custom settings are needed. Never commit .env.
APP_ENV=local
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=var/app-demo.sqlite3
AUTH_MODE=demo
LLM_MODE=mock
# Optional CPU inference. Install the CAS dependencies before uncommenting.
# start.cmd/start.sh run from backend/. An absolute path is also supported.
# CAS_RETRAINED_BUNDLE=data/models/cas-dl2-retrain-20261124
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
DIALOGUE_HISTORY_LIMIT=20
# Explicit run-worker command only; serve never starts the worker.
RUNNER_POLL_SECONDS=5
RUNNER_MAX_TASKS=100
CONFIG_VERSION=s01-config-v1
